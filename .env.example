# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server-side JSON-RPC endpoints (proxied via /api/rpc/*)
BASE_MAINNET_RPC_URL="https://mainnet.base.org"
ETH_MAINNET_RPC_URL="https://ethereum-rpc.publicnode.com"
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
ETH_SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Server-side ERC-4337 Bundler & Paymaster Secrets (proxied via /api/bundler/*)
pimlico_api_key="YOUR_PIMLICO_API_KEY"
pimlico_Policy_ID="YOUR_PIMLICO_SPONSORSHIP_POLICY_ID"
pimlico_rpc_eth="https://api.pimlico.io/v2/1/rpc?apikey=YOUR_PIMLICO_API_KEY"
pimlico_rpc_base="https://api.pimlico.io/v2/8453/rpc?apikey=YOUR_PIMLICO_API_KEY"

# Optional Alchemy RPC & Gas Manager Policy Secrets (proxied via /api/rpc/* and /api/bundler/alchemy/*)
alchemy_api_key="YOUR_ALCHEMY_API_KEY"
alchemy_Policy_eth="YOUR_ALCHEMY_GAS_MANAGER_POLICY_ID"
